#!/usr/bin/with-contenv bashio
# shellcheck shell=bash
# ==============================================================================
# Start the web terminal (ttyd) with EBaC running in it.
#
# Each time someone opens EBaC in the sidebar, ttyd starts a fresh copy of
# the program. When the user exits EBaC, ttyd greys the screen and offers
# "Press Enter to Reconnect", just like the Terminal app.
# ==============================================================================
bashio::log.info "Starting EBaC..."

# Where EBaC's files are (the program, 'trans' and the AV folder).
export BIBLEROOT=/usr/share/ebac

# /data is the app's own storage, kept across restarts, updates and
# backups. Each user's search history goes in /data/users/NAME; see
# /usr/bin/ebac-session.
mkdir -p /data/users
cd /data || bashio::exit.nok "Can't find the /data folder!"

# --auth-header: Home Assistant's ingress adds the logged-in user's name in
# X-Remote-User-Name; ttyd passes it to ebac-session as TTYD_USER (and
# refuses connections without it, which only come from outside ingress).
# --index: ttyd's own page with touch gestures added (see the Dockerfile).
exec ttyd --writable --port 8099 --client-option titleFixed=EBaC \
    --auth-header X-Remote-User-Name \
    --index /usr/share/ebac/index.html \
    /usr/bin/ebac-session
