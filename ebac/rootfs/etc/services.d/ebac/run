#!/usr/bin/with-contenv bashio
# shellcheck shell=bash
# ==============================================================================
# Start the web terminal (ttyd) with EBaC running in it.
#
# Each time someone opens EBaC in the sidebar, ttyd starts a fresh copy of
# the program. When the user exits EBaC, ttyd greys the screen and offers
# "Press Enter to Reconnect", just like the Terminal app.
# ==============================================================================
bashio::log.info "Starting EBaC..."

# /data is the app's own storage, kept across restarts, updates and
# backups. Each user's search history goes in /data/users/NAME; see
# /usr/bin/ebac-session.
mkdir -p /data/users
cd /data || bashio::exit.nok "Can't find the /data folder!"

# EBaC's folder: /data/ebac, holding the translations users add (A on the
# main menu) and links to the app's own files; see /usr/bin/ebac-setup.
/usr/bin/ebac-setup || bashio::exit.nok "Can't set up /data/ebac!"
export BIBLEROOT=/data/ebac

# The web page: with the troubleshooting option on, a copy that shows what
# the page sees of the focus and the window's size (see gestures.js).
page=/usr/share/ebac/index.html
if bashio::config.true 'debug_overlay'; then
    bashio::log.info "Troubleshooting box on (debug_overlay)"
    sed 's|<head>|<head><script>window.EBAC_DEBUG=true</script>|' "$page" > /tmp/index.html
    page=/tmp/index.html
fi

# --auth-header: Home Assistant's ingress adds the logged-in user's name in
# X-Remote-User-Name; ttyd passes it to ebac-session as TTYD_USER (and
# refuses connections without it, which only come from outside ingress).
# --index: ttyd's own page with touch gestures added (see the Dockerfile).
# theme: white on black, for the most contrast (ttyd's own is light grey on
# dark grey, which makes Hebrew's small vowel points hard to see); bold
# text white too, not a brighter grey.
exec ttyd --writable --port 8099 --client-option titleFixed=EBaC \
    --client-option 'theme={"foreground":"#ffffff","background":"#000000","cursor":"#ffffff","cursorAccent":"#000000","selectionBackground":"#5a5a5a","white":"#ffffff","brightWhite":"#ffffff"}' \
    --auth-header X-Remote-User-Name \
    --index "$page" \
    /usr/bin/ebac-session
